# 环境变量配置文件
# 复制此文件为 .env 并填入实际值

# ===========================================
# LLM API 配置
# ===========================================

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# 自定义API Key（用于custom provider）
CUSTOM_API_KEY=your_custom_api_key_here

# ===========================================
# 可选：自定义API端点
# ===========================================

# Claude API 端点（默认: https://api.anthropic.com）
# ANTHROPIC_BASE_URL=

# OpenAI API 端点（默认: https://api.openai.com/v1）
# OPENAI_BASE_URL=

# ===========================================
# 本地服务配置
# ===========================================

# Ollama 端点（默认: http://localhost:11434）
# OLLAMA_ENDPOINT=http://localhost:11434

# Trae IDE 端点（默认: http://localhost:8080）
# TRAE_ENDPOINT=http://localhost:8080
